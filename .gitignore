*.log
npm-debug.log*
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# test artifacts
coverage/
playwright-report/
test-results/

# local scratch (screenshots, notes — not for the repo)
local/

# Prod data snapshots (personal data — never commit)
backups/
