{
  // Editor-support config so the TS server resolves this package (and its tests)
  // with the repo's compiler options instead of an inferred default project.
  // vitest.setup.ts is included so component tests see the jest-dom matcher
  // augmentation (toBeInTheDocument, etc.). `npm run typecheck` still checks
  // everything via ../../tsconfig.typecheck.json.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "node"]
  },
  "include": ["src", "../../vitest.setup.ts"]
}
